# Copy this file to the repository root as .env and fill in values.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
DATABASE_PATH=./data/app.db
AUTH_USERNAME=
AUTH_PASSWORD=
AUTH_SESSION_SECRET=
CORS_ORIGIN=
# Admin key for /api/admin/cleanup-images endpoint (required in production)
ADMIN_KEY=
# Translate configuration
# Article translation uses Baidu AI Text Translation.
TRANSLATE_PROVIDER=baidu
BAIDU_TRANSLATE_APPID=
BAIDU_AI_TRANSLATE_API_KEY=
TRANSLATE_API_KEY=
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_REGION=ap-guangzhou

# Eudic token (optional)
EUDIC_TOKEN=

# Merriam-Webster Learner's Dictionary API
MERRIAM_WEBSTER_LEARNERS_KEY=

# Google Gemini configuration for text analysis
GOOGLE_GEMINI_API_KEY=
GOOGLE_GEMINI_MODEL=gemini-flash-latest

# Analysis provider configuration
# Supported providers: openai, gemini, fallback
ANALYSIS_PROVIDER=openai
ANALYSIS_PROMPT_VERSION=v4
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.chatanywhere.tech
# For ChatAnywhere free proxy, use chat_completions to avoid responses restrictions.
OPENAI_API_MODE=chat_completions
OPENAI_MODEL=gpt-5.4-mini