# Copy this file to .env and fill in values for local development
# Translate configuration
# Supported providers: tencent, libre, mock
# For Tencent Cloud TextTranslation, set TENCENT_SECRET_ID and TENCENT_SECRET_KEY.
TRANSLATE_PROVIDER=tencent
TRANSLATE_API_KEY=
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_REGION=ap-guangzhou

# Eudic token (optional)
EUDIC_TOKEN=

# Google Gemini configuration for text analysis
GOOGLE_GEMINI_API_KEY=
GOOGLE_GEMINI_MODEL=gemini-flash-latest

# Analysis provider configuration
# Supported providers: openai, gemini, fallback
ANALYSIS_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.chatanywhere.tech
# For ChatAnywhere free proxy, use chat_completions to avoid responses restrictions.
OPENAI_API_MODE=chat_completions
OPENAI_MODEL=gpt-5.4-mini

# Server port (optional)
PORT=3001
